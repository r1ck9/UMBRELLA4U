# Copy this file to ".env.local" and fill in the two values below.
# Get them from your Supabase project: Settings → API.
# (The app runs with sample data even if these are blank.)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GIPHY API key used by the in-composer GIF picker. GIPHY requires searches to
# run client-side, so this is intentionally a public browser key. Configure the
# key's maximum content rating as G in the GIPHY developer dashboard too.
NEXT_PUBLIC_GIPHY_API_KEY=

# Optional — enables FREE AI content moderation on new posts (server-side only).
# Get a key from platform.openai.com (the moderation endpoint is free to use).
# Leave blank to skip AI moderation.
OPENAI_API_KEY=

# ---- EMAIL NOTIFICATIONS (the daily digest / prompt / welcome-back / report alerts) ----
# Set these in your Vercel project (Settings → Environment Variables), not just locally.
# If ANY of the first two are missing, NO emails are ever sent:

# Lets the server read emails + run the daily job. Supabase → Settings → API →
# "service_role" secret. NEVER expose this in the browser / never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (resend.com). Without it every email is silently skipped.
RESEND_API_KEY=

# The "from" address — MUST be on a domain you've verified in Resend,
# otherwise Resend rejects the send. e.g. Umbrella <hello@umbrella4u.ca>
NOTIFY_FROM=

# Your live site URL, used for links inside the emails. e.g. https://umbrella4u.ca
SITE_URL=

# Where moderator report alerts go.
MODERATOR_ALERT_EMAIL=

# Shared secret Vercel Cron sends to authorize the daily job. Set the SAME value
# here and in Vercel. You can also manually test with /api/notify?secret=THIS_VALUE
CRON_SECRET=
